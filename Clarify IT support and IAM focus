-spacing:-.05em;margin:0}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.info{border:1px solid var(--line);border-radius:16px;padding:28px}.info b{color:var(--blue);font-size:1.5rem}.info h3{margin:18px 0 7px}.info p,.steps p{color:var(--muted);margin:0}.dark{background:var(--dark);color:white}.light .eyebrow{color:var(--cyan)}.skills{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:#384457}.skills div{background:var(--dark);padding:27px}.skills strong,.skills span{display:block}.skills span{color:#aeb9c9;font-size:.92rem;margin-top:7px}.path{display:grid;grid-template-columns:.8fr 1.2fr;gap:90px}.steps{list-style:none;margin:0;padding:0;border-top:1px solid var(--line)}.steps li{display:flex;gap:25px;padding:23px 0;border-bottom:1px solid var(--line)}.steps li>span{color:var(--blue);font-weight:800}.steps h3{margin:0 0 4px}.connect{background:var(--blue);color:white}.connectin{display:flex;justify-content:space-between;align-items:center;gap:30px;padding:65px 0}.connect h2{font-size:clamp(2rem,4vw,3rem);line-height:1.05;letter-spacing:-.05em;margin:0 0 10px}.connect p{color:#dbeafe}.lightbtn{background:white;color:var(--blue);white-space:nowrap}footer{background:#0b1220;color:#aeb9c9;padding:25px 0;font-size:.85rem}footer .wrap{display:flex;justify-content:space-between}@media(max-width:800px){.menu-toggle{display:block;background:none;border:0;font-size:1.7rem;cursor:pointer;color:var(--ink);padding:6px}header nav{display:none;position:absolute;top:68px;right:0;left:0;background:white;border:1px solid var(--line);border-radius:14px;padding:10px;box-shadow:0 12px 30px rgba(17,24,39,.12);z-index:10}header nav.open{display:flex;flex-direction:column;gap:0}header nav a{display:block;padding:12px 14px}header nav a:last-child{background:var(--ink);color:white;margin-top:5px;text-align:center}.hero{grid-template-columns:1fr;gap:40px;padding:65px 0 75px}.section{padding:70px 0}.cards,.skills{grid-template-columns:1fr}.path{display:block}.connectin{display:block}.connectin .buttons{flex-direction:column;align-items:stretch;gap:12px}.lightbtn{display:block;width:100%;margin-top:0;text-align:center}footer .wrap{display:block}}</style></head><body><header class="wrap"><a href="#top">Sneakers Lab 👟</a><button class="menu-toggle" aria-label="Open navigation menu" aria-expanded="false">☰</button><nav><a href="#about">About</a><a href="#experience">Experience</a><a href="#path">How it works</a><a href="#connect">Get involved</a></nav></header><main id="top"><section class="hero wrap"><div><p class="eyebrow">Practical IT learning, one step at a time</p><h1>Build practical IT support and identity and access management experience.</h1><p class="lead">Sneakers Lab is a hands-on learning environment where students and career changers practice IT support, Windows administration, networking, and identity and access management using realistic scenarios.</p><div class="buttons"><a class="button primary" href="#experience">Explore the lab</a><a class="button secondary" href="#connect">Ask a question</a></div></div><div class="card"><div class="shoe">👟</div><p class="eyebrow">The goal</p><h2>Turn study into proof of work.</h2><p>Learn the tools, document the work, and build a portfolio you can explain in an interview.</p></div></section><section id="about" class="section wrap"><div class="heading"><p class="eyebrow">Why Sneakers Lab</p><h2>Learning works better when it feels real.</h2></div><div class="cards"><article class="info"><b>⌘</b><h3>Hands-on practice</h3><p>Work through realistic user, workstation, account, and service scenarios instead of only reading about them.</p></article><article class="info"><b>▣</b><h3>Documented work</h3><p>Use tickets, notes, checklists, and change records to practice the habits employers expect.</p></article><article class="info"><b>↗</b><h3>Career momentum</h3><p>Build confidence and portfolio evidence that help you explain your skills clearly.</p></article></div></section><section id="experience" class="dark"><div class="section wrap"><div class="heading light"><p class="eyebrow">Inside the lab</p><h2>Practice IT support and identity work in a realistic lab.</h2></div><div class="skills"><div><strong>Windows & servers</strong><span>Workstations, Active Directory, Group Policy, and administration.</span></div><div><strong>Identity & access</strong><span>Users, groups, permissions, account lifecycle, and least privilege.</span></div><div><strong>Networking fundamentals</strong><span>DNS, connectivity, addressing, and troubleshooting.</span></div><div><strong>Help desk operations</strong><span>Ticket intake, diagnosis, communication, escalation, and resolution notes.</span></div><div><strong>Security fundamentals</strong><span>Practice account security, least privilege, secure configuration, and clear documentation as part of everyday IT support.</span></div><div><strong>Professional proof</strong><span>Turn completed work into explainable, repeatable skills.</span></div></div></div></section><section class="section wrap"><div class="heading"><p class="eyebrow">How the lab runs</p><h2>A controlled virtual environment for realistic practice.</h2></div><div class="cards"><article class="info"><b>⌘</b><h3>Virtual lab infrastructure</h3><p>Oracle VirtualBox hosts the Windows Server 2025 and Windows 11 lab machines. It lets us build, reset, and improve scenarios while keeping lab activity isolated from the host computer.</p></article><article class="info"><b>▣</b><h3>Client01: student workspace</h3><p>Client01 is the Windows 11 workstation where participants do assigned work. They use it to handle help desk tickets, troubleshoot sign-in and policy issues, test changes, and document what they did.</p></article><article class="info"><b>↗</b><h3>DC01: lab services</h3><p>DC01 runs Windows Server 2025 and provides Active Directory, user accounts, groups, Group Policy, and DNS. It supplies the domain services and realistic problems that make Client01 scenarios possible.</p></article><article class="info"><b>↔</b><h3>Controlled remote access</h3><p>Tailscale and RustDesk provide controlled remote access to the assigned lab workstation. Participants can work in Client01 without receiving access to the host computer or the full lab administration environment.</p></article></div></section><section id="path" class="section wrap path"><div class="heading"><p class="eyebrow">A practical path</p><h2>Learn. Practice. Document. Explain.</h2></div><ol class="steps"><li><span>01</span><div><h3>Learn the concept</h3><p>Start with the Windows, networking, identity, or security principle behind the task.</p></div></li><li><span>02</span><div><h3>Work the scenario</h3><p>Apply the concept in a lab environment with a realistic user or system problem.</p></div></li><li><span>03</span><div><h3>Record the evidence</h3><p>Capture what changed, what you tested, and how you would communicate the result.</p></div></li><li><span>04</span><div><h3>Explain the decision</h3><p>Practice describing your troubleshooting process in plain language.</p></div></li></ol></section><section id="connect" class="connect"><div class="wrap connectin"><div><p class="eyebrow">Interested in Sneakers Lab?</p><h2>Follow the build and learn along with us.</h2><p>Questions, collaboration ideas, and feedback are welcome as the lab develops.</p><p class="privacy-note">Your email is used only for Sneakers Lab updates. We do not sell it, and you can choose not to be contacted.</p></div><div class="buttons"><a class="button lightbtn" href="https://www.tiktok.com/@joseph.dreambuilder" target="_blank" rel="noopener">Follow on TikTok ↗</a><a class="button lightbtn" href="https://docs.google.com/forms/d/e/1FAIpQLScoq1D_rJ3cLlERICC5P72SDmhMtOetcEkCAYhLEiMu8oP0yw/viewform" target="_blank" rel="noopener">Join the interest list ↗</a></div></div></section></main><footer><div class="wrap"><span>Sneakers Lab 👟</span><span>Practical IT learning in public.</span></div></footer><script>const menuButton=document.querySelector(".menu-toggle"),nav=document.querySelector("nav");menuButton.addEventListener("click",()=>{const open=nav.classList.toggle("open");menuButton.setAttribute("aria-expanded",open);menuButton.setAttribute("aria-label",open?"Close navigation menu":"Open navigation menu")});nav.querySelectorAll("a").forEach(link=>link.addEventListener("click",()=>{nav.classList.remove("open");menuButton.setAttribute("aria-expanded","false");menuButton.setAttribute("aria-label","Open navigation menu")}));</script><div class="wrap" style="padding:24px 0;color:#667085;font-size:.9rem"><p>Hands-on participation is arranged individually. Lab access is provided only after onboarding and agreement to the written participation and acceptable-use rules.</p></div></body></html>
